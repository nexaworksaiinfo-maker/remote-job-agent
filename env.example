# Remote Job Agent - Environment Configuration
# Copy this file to .env and fill in your credentials

# =============================================================================
# REQUIRED - Application
# =============================================================================
APP_NAME="Remote Job Agent"
APP_VERSION="1.0.0"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="your-super-secret-key-min-32-chars-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
TIMEZONE="UTC"
LANGUAGE="en"
SUPPORTED_LANGUAGES=["en", "ru", "es", "fr", "de", "zh", "pt", "ar"]
SUPPORTED_CURRENCIES=["USD", "EUR", "GBP", "RUB", "CAD", "AUD", "JPY", "CNY", "INR", "BRL"]

# =============================================================================
# REQUIRED - Database (auto-configured in Docker)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=remote_job_agent
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=remote_job_agent
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30

# =============================================================================
# REQUIRED - Redis (auto-configured in Docker)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# REQUIRED - Celery
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_PREFETCH_MULTIPLIER=4

# =============================================================================
# REQUIRED - OpenAI (for embeddings and cover letters)
# =============================================================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# =============================================================================
# REQUIRED - LinkedIn (for scraping and applying)
# =============================================================================
LINKEDIN_EMAIL=your-linkedin-email
LINKEDIN_PASSWORD=your-linkedin-password
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# =============================================================================
# OPTIONAL - Indeed
# =============================================================================
INDEED_API_KEY=
INDEED_PUBLISHER_ID=

# =============================================================================
# OPTIONAL - Other Job Sources
# =============================================================================
REMOTEOK_API_KEY=
WELLFOUND_API_KEY=
YC_JOBS_API_KEY=
GLASSDOOR_API_KEY=
GLASSDOOR_PARTNER_ID=

# =============================================================================
# OPTIONAL - Telegram Bot (for notifications)
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
TELEGRAM_ADMIN_IDS=

# =============================================================================
# OPTIONAL - Discord Bot
# =============================================================================
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# =============================================================================
# OPTIONAL - Email (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@remotejobagent.com
EMAIL_FROM_NAME="Remote Job Agent"

# =============================================================================
# OPTIONAL - Cal.com (Interview scheduling)
# =============================================================================
CAL_COM_API_KEY=
CAL_COM_USERNAME=

# =============================================================================
# OPTIONAL - Google Calendar
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# =============================================================================
# OPTIONAL - Browser Automation (Playwright)
# =============================================================================
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=100
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_USER_DATA_DIR=/tmp/playwright

# =============================================================================
# OPTIONAL - Anti-detection
# =============================================================================
ROTATE_USER_AGENTS=true
ROTATE_PROXIES=false
PROXY_LIST=[]
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=5.0

# =============================================================================
# OPTIONAL - Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_BURST=20

# =============================================================================
# OPTIONAL - CORS
# =============================================================================
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# OPTIONAL - Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/remote-job-agent/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# OPTIONAL - Monitoring
# =============================================================================
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_JOB_SCRAPING=true
FEATURE_JOB_MATCHING=true
FEATURE_AUTO_APPLY=true
FEATURE_TELEGRAM_BOT=true
FEATURE_DISCORD_BOT=true
FEATURE_EMAIL_ALERTS=true
FEATURE_LANDING_PAGE=true
FEATURE_ADMIN_DASHBOARD=true
FEATURE_ANALYTICS=true
FEATURE_MULTI_CURRENCY=true
FEATURE_MULTI_LANGUAGE=true

# =============================================================================
# JOB MATCHING SETTINGS
# =============================================================================
MATCH_THRESHOLD=0.65
SEMANTIC_WEIGHT=0.5
SKILL_WEIGHT=0.3
EXPERIENCE_WEIGHT=0.15
SALARY_WEIGHT=0.05

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
MAX_DAILY_APPLICATIONS=20
MAX_CONCURRENT_APPLICATIONS=3
APPLICATION_TIMEOUT=120
RETRY_FAILED_APPLICATIONS=true
MAX_RETRIES=3

# =============================================================================
# DEPLOYMENT
# =============================================================================
DEPLOYMENT_PLATFORM=docker
RAILWAY_STATIC_URL=
RENDER_EXTERNAL_URL=
FLY_APP_NAME=